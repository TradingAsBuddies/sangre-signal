# Sangre Signal Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key for Claude AI-powered analysis
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Only needed for identity-linked API keys (keys scoped to a user rather than a
# workspace). Those are rejected with a 400 unless the workspace id accompanies
# them. Leave blank for ordinary workspace-scoped keys.
ANTHROPIC_WORKSPACE_ID=

# Perplexity API Key for Perplexity AI-powered analysis
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-key-here
